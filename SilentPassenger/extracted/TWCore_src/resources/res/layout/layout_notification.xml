<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_notify_icon"
            android:layout_width="40px"
            android:layout_height="40px"
            android:layout_marginLeft="15px"
            android:layout_centerVertical="true"/>
        <TextView
            android:id="@+id/view_center"
            android:layout_width="1px"
            android:layout_height="1px"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="20px"
            android:textColor="#4a4a4a"
            android:id="@+id/tv_notify_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="17px"
            android:layout_marginBottom="2px"
            android:layout_toRightOf="@+id/iv_notify_icon"
            android:layout_above="@+id/view_center"/>
        <TextView
            android:textSize="18px"
            android:textColor="#828282"
            android:id="@+id/tv_notify_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="17px"
            android:layout_marginTop="2px"
            android:layout_toRightOf="@+id/iv_notify_icon"
            android:layout_below="@+id/view_center"/>
        <TextView
            android:textSize="20px"
            android:textColor="#4a4a4a"
            android:id="@+id/tv_notify_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12px"
            android:layout_marginRight="20px"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</RelativeLayout>
